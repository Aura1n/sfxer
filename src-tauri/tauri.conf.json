{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sfxer",
  "version": "0.9.0",
  "identifier": "dev.zara.sfxer",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "sfxer",
        "width": 1320,
        "height": 720,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "maximized": true,
        "resizable": true,
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "shortDescription": "Local audio asset manager",
    "longDescription": "Tag, annotate and search a local audio library"
  }
}
